# Domain DNS must point to the deployment host. Do not include https:// here.
SITE_HOST=game.example.com
# Use independent random hexadecimal values (at least 32 characters each).
POSTGRES_PASSWORD=replace-with-a-random-hexadecimal-password
APP_SECRET=replace-with-a-different-random-secret
# On Linux, this directory must be writable by the container's node user (uid 1000).
BACKUP_PATH=./.local-backups
